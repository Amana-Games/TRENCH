#include "@CMAKE_BINARY_DIR@/lib/TbUiLib/ui/Version.h"

AAAAAAAA                ICON                    "@TB_RESOURCE_DIR@/win32/icons/AppIcon.ico"
APPICON                 ICON                    "@TB_RESOURCE_DIR@/win32/icons/DocIcon.ico"

1 VERSIONINFO
 FILEVERSION VERSION_WIN_RC
 PRODUCTVERSION VERSION_WIN_RC
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TRENCH"
            VALUE "FileDescription", "TRENCH"
            VALUE "FileVersion", VERSION_WIN_RC
            VALUE "InternalName", "TRENCH.exe"
            VALUE "LegalCopyright", "Amana Games"
            VALUE "OriginalFilename", "TRENCH.exe"
            VALUE "ProductName", "TRENCH"
            VALUE "ProductVersion", VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
